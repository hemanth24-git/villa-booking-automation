    {
      "parameters": {
        "jsCode": "const events = $input.all().filter(item => item.json && item.json.id);\n\nconst items = events.map(item => {\n  const e = item.json;\n  const startRaw = (e.start && (e.start.date || e.start.dateTime)) || '';\n  const endRaw = (e.end && (e.end.date || e.end.dateTime)) || '';\n  return { json: { start: startRaw.slice(0, 10), end: endRaw.slice(0, 10) } };\n}).filter(it => it.json.start && it.json.end);\n\nif (items.length === 0) return [{ json: { start: '', end: '' } }];\nreturn items;"
      },
