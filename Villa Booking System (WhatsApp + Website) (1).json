      "parameters": {
        "jsCode": "const text = $input.first().json.output;\n\nconst name = text.match(/name:\\s*(.+)/i)?.[1]?.trim() || \"\";\nconst checkin = text.match(/checkin:\\s*(.+)/i)?.[1]?.trim() || \"\";\nconst checkout = text.match(/checkout:\\s*(.+)/i)?.[1]?.trim() || \"\";\nconst guests = text.match(/guests:\\s*(.+)/i)?.[1]?.trim() || \"\";\nconst phone = ($('WhatsApp Webhook').first().json.body.From || \"\").replace('whatsapp:', '');\n\nconst parts = name.split(' ');\nconst firstName = parts.shift() || name;\nconst lastName = parts.join(' ');\n\nreturn [{ json: { name, firstName, lastName, checkin, checkout, guests, phone, email: \"\" } }];"
      },
