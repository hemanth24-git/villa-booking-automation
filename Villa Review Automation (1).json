      "parameters": {
        "jsCode": "const items = $input.all();\nconst lines = items.map((it,i)=>{ const r=it.json; return `${i+1}. [${r.rating} stars] ${r.reviewer}: ${r.text}`; }).join('\\n');\nreturn [{ json: { digest: lines, count: items.length } }];"
      },
