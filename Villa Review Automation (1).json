              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "029dbac1-7d06-4ba8-8262-ea2e01854d16",
      "name": "Happy or Unhappy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        576,
