      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\":\"gpt-4o-mini\", \"temperature\":0.7, \"messages\":[ {\"role\":\"system\",\"content\":\"You are the host and owner of [VILLA_NAME], a boutique villa in [LOCATION]. Write a warm, genuine, personal PUBLIC reply to this positive Google review from a guest who stayed with you. Rules: 2-3 short sentences; sound like a real, warm host, not a corporate template; reference something specific they mentioned (the view, the food, the pool, the staff, etc.); thank them by first name if given; warmly invite them to come back and stay again. Reply with ONLY the reply text, nothing else.\"}, {\"role\":\"user\",\"content\":\"Reviewer: \"+$json.reviewer+\"\\nRating: \"+$json.rating+\" stars\\nReview: \"+$json.text} ] } }}",
        "options": {}
      },
      "id": "8d1c39f5-768e-440d-909b-5bcd5dd9335a",
      "name": "Draft Happy Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        160
      ],
      "credentials": {
        "openAiApi": {
          "id": "3KsiYOQqnRX3DnBG",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\":\"gpt-4o-mini\", \"temperature\":0.6, \"messages\":[ {\"role\":\"system\",\"content\":\"You are the host and owner of [VILLA_NAME], a boutique villa in [LOCATION]. Write a calm, empathetic, gracious PUBLIC reply to this less-than-positive Google review from a guest. Rules: 2-3 short sentences; sincerely acknowledge their experience fell short WITHOUT being defensive or making excuses; thank them for the honest feedback; warmly invite them to contact you directly by phone or WhatsApp so you can make it right and host them better next time. Never argue or blame the guest. Reply with ONLY the reply text, nothing else.\"}, {\"role\":\"user\",\"content\":\"Reviewer: \"+$json.reviewer+\"\\nRating: \"+$json.rating+\" stars\\nReview: \"+$json.text} ] } }}",
        "options": {}
      },
      "id": "e5e0d5cf-a494-46a2-a788-10eba37ea455",
      "name": "Draft Careful Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        400
      ],
      "credentials": {
        "openAiApi": {
          "id": "3KsiYOQqnRX3DnBG",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const reply = (($json.choices && $json.choices[0] && $json.choices[0].message.content) || '').trim();\nconst r = $('Flatten & Normalize Reviews').item.json;\nconst sentiment = (Number(r.rating) >= 4) ? 'Positive' : 'Needs Attention';\nreturn {\n  REVIEWER: r.reviewer,\n  RATING: r.rating,\n  SENTIMENT: sentiment,\n  REVIEW: r.text,\n  DRAFT_REPLY: reply,\n  STATUS: 'Pending Approval',\n  REVIEW_DATE: r.date,\n  REVIEW_URL: r.url,\n  GENERATED_AT: new Date().toISOString()\n};"
      },
